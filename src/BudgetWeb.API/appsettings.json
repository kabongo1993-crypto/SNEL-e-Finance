{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=BD_SNEL;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "BudgetWeb-SNEL",
    "Audience": "BudgetWeb-Client",
    "SecretKey": ""
  },
  "Import": {
    "CorrespondanceFilePath": "Correspondance_Organisationnelle_Budget_Web.xlsx",
    "SnelComptesFilePath": "Tableau_Comptes_SYSCOHADA_Sections_Colore.xlsx"
  },
  "Documents": {
    "PrevisionsPath": "App_Data/documents/previsions"
  },
  "Storage": {
    "PiecesJustificatives": {
      "RootPath": "D:\\BudgetWebData\\pieces-justificatives",
      "MaxFileSizeBytes": 10485760,
      "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".doc", ".docx", ".xls", ".xlsx" ]
    }
  },
  "QuestPdf": {
    "Warmup": {
      "Enabled": false,
      "BlockStartup": false
    }
  }
}
