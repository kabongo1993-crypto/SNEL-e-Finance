# Copier vers /etc/snel-e-finance/mcp.env sur le serveur.
# NE PAS y mettre Jwt__SecretKey dans Git. Le secret reste uniquement sur le serveur.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5260
Mcp__PublicBaseUrl=https://mcp-snel.christresfort.app
Mcp__ApiBaseUrl=http://127.0.0.1:5100
Mcp__TrustedNetworks__0=172.16.0.0/12
Mcp__TrustedNetworks__1=10.0.0.0/8
Jwt__Issuer=BudgetWeb-SNEL
Jwt__Audience=BudgetWeb-Client
# Jwt__SecretKey=<identifique à BudgetWeb.API — uniquement dans /etc/snel-e-finance/mcp.env>
